modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "mobile-build-ios"

[[workflows.workflow]]
name = "mobile-build-ios"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/mobile && EXPO_PUBLIC_DOMAIN=msafirikenya.com npx expo export --platform ios --output-dir /tmp/expo-export-validate"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["revenuecat:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["eas-cli"]

[userenv]

[userenv.shared]
REVENUECAT_PROJECT_ID = "projae197094"
REVENUECAT_TEST_STORE_APP_ID = "appda86a73f1a"
REVENUECAT_APPLE_APP_STORE_APP_ID = "app04cc3ac658"
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY = "test_NpbxUUJoJudMdUxALbNRtPEVkjD"
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY = "appl_VyhAmjuUAnTtmpXrGBkRrmfKEWQ"
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY = "goog_ooNOODiUZCkYXUFSBbDimjbtSHL"
ADMIN_JWT_SECRET = "lMuenV2uOsO8mh5upcwclnsZoYGHV1vugJvhhCwFsxDexta2Bu-BrPMiOO2oHHk8"
RESEND_FROM = "Msafiri Kenya <noreply@msafirikenya.com>"
REVENUECAT_GOOGLE_PLAY_STORE_APP_ID = "appd3493629e8"

[objectStorage]
defaultBucketID = "replit-objstore-6e199dcc-7921-48c5-b057-400d8786487c"

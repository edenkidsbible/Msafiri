{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "baseUrl": ".",
    "strict": true,
    "moduleSuffixes": [".native", ".web", ""],
    "paths": {
      "@/*": [
        "./*"
      ],
      // expo-file-system ships TS sources; its legacy entry re-exports src/,
      // which our moduleSuffixes ordering mis-resolves (picks .web shim on a
      // native check). Point tsc at the prebuilt declarations instead.
      "expo-file-system/legacy": [
        "./node_modules/expo-file-system/build/legacy/index.d.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "references": [
    {
      "path": "../../lib/api-client-react"
    }
  ]
}
